<!doctype html>
<html$if(lang)$ lang="$lang$"$endif$>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
$for(author-meta)$<meta name="author" content="$author-meta$">$endfor$
$if(date-meta)$<meta name="dcterms.date" content="$date-meta$">$endif$
<title>$if(title-prefix)$$title-prefix$ – $endif$$pagetitle$</title>
$for(css)$<link rel="stylesheet" href="$css$">$endfor$
$for(header-includes)$$header-includes$$endfor$
</head>
<body>
$for(include-before)$$include-before$$endfor$
$if(toc)$<nav id="$idprefix$TOC" role="doc-toc">$table-of-contents$</nav>$endif$
<header id="title-block-header">
$if(title)$<h1 class="title">$title$</h1>$endif$
$if(subtitle)$<p class="subtitle">$subtitle$</p>$endif$
$if(author)$<p class="author">$for(author)$$author$$sep$, $endfor$</p>$endif$
$if(date)$<p class="date">$date$</p>$endif$
</header>
<main>
$body$
</main>
$for(include-after)$$include-after$$endfor$
</body>
</html>
